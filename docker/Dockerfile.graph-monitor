FROM rust:1.96-bookworm AS build

WORKDIR /root

COPY . .

RUN cargo build --release --bin graph-monitor

########################################################################################

FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /root/target/release/graph-monitor /usr/local/bin/graph-monitor

EXPOSE 9090

ENTRYPOINT [ "/usr/local/bin/graph-monitor" ]
CMD [ "serve" ]
